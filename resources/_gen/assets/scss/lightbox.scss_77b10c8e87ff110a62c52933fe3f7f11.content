.post-body img{cursor:zoom-in}.image-lightbox{position:fixed;inset:0;z-index:2000;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;background:rgba(0,0,0,.85);cursor:zoom-out;opacity:0;visibility:hidden;transition:opacity .2s ease,visibility .2s ease}.image-lightbox-visible{opacity:1;visibility:visible}.image-lightbox-figure{max-width:100%;max-height:85vh;object-fit:contain;box-shadow:0 4px 24px rgba(0,0,0,.4)}.image-lightbox-caption{margin-top:12px;color:rgba(255,255,255,.85);font-size:14px;text-align:center}