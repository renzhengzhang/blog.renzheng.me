.toc{float:none;width:calc(100% - 48px);min-width:0;max-width:320px;max-height:calc(100vh - 60px);margin:30px 24px;overflow:auto;background:#fff;border:1px solid rgba(25,118,210,.12);border-radius:5px;box-shadow:0 0 8px rgba(0,0,0,.1)}.toc .toc-content{padding:16px}.toc .toc-title{margin:0 0 10px;padding-bottom:10px;border-bottom:1px solid rgba(25,118,210,.12);color:#0d3769;font-size:16px;font-weight:500;line-height:1.4}.toc ul{margin:0;padding:0;list-style:none}.toc ul ul{margin:4px 0 0 8px;padding-left:12px;border-left:1px solid rgba(25,118,210,.16)}.toc li{margin:2px 0}.toc a{display:block;padding:5px 8px;border-radius:3px;color:#0d3769;font-size:14px;line-height:1.5;text-decoration:none;transition:background-color .2s linear,color .2s linear}.toc a:hover{background:rgba(25,118,210,7%);color:#145ca4}.toc a.toc-active{background:rgba(25,118,210,.1);color:#145ca4!important;font-weight:500}body.night .toc{background:#282828;border-color:rgba(25,118,210,.3);box-shadow:0 0 8px rgba(0,0,0,.2)}body.night .toc .toc-title,body.night .toc a{color:#e6e6e6}body.night .toc .toc-title,body.night .toc ul ul{border-color:rgba(25,118,210,.3)}body.night .toc a:hover,body.night .toc a.toc-active{background:rgba(25,118,210,.2);color:#64a9ed!important}@media screen and (max-width:1020px){.single-column-drawer-container .toc{width:auto;max-width:none;max-height:calc(100vh - 220px);margin:16px 20px}.single-column-drawer-container .toc .toc-content{padding:14px}}